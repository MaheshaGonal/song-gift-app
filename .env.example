# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay — Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret

# Razorpay — Dashboard → Settings → Webhooks (set the same value in both places)
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Your own password for the /admin dashboard
ADMIN_PASSWORD=choose-a-strong-password

# Optional: n8n webhook URL to notify yourself of new paid orders
# N8N_NEW_ORDER_WEBHOOK_URL=https://your-n8n-instance/webhook/new-order
